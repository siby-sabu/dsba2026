[flake8]
# Set max line length to 88 (Black's default)
max-line-length = 88

# Ignore specific errors
ignore =
    E203,  # Whitespace before ':' (conflicts with Black)
    W503,  # Line break before binary operator (conflicts with Black)

# Or completely ignore line length checks
# ignore = E501

# Exclude certain directories
exclude =
    .git,
    __pycache__,
    .venv,
    dsba,
    build,
    dist,
    *.egg-info,
    .ipynb_checkpoints
